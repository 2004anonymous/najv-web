
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function staff() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.active == true
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role in ["admin", "editor"];
    }

    function admin() {
      return staff()
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    match /school-pdfs/{fileName} {
      allow read: if true;

      allow create, update: if staff()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == "application/pdf";

      allow delete: if admin();
    }
  }
}
